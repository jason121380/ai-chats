DATABASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
# One key for every vendor OpenRouter carries. Model IDs are OpenRouter slugs
# such as anthropic/claude-sonnet-4.5; pick them in 設定 → 新增模型.
OPENROUTER_API_KEY=

# Shared secret guarding every route. Required in production — the app
# refuses to start without it. Generate one with: openssl rand -base64 32
APP_SECRET=

# Optional server tuning
# PROVIDER_TIMEOUT_MS=120000
# COUNCIL_STALE_AFTER_MS=900000
