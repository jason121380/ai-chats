// AI Council — Prisma schema
// PostgreSQL is the single source of truth for conversations, council runs,
// model runs (the billing ledger), model configuration, and pricing.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum SessionMode {
  SOLO
  COMPARE
  COUNCIL
  DISCUSSION
  BATTLE
}

enum SessionStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageSource {
  USER
  MODEL
  CHAIRMAN
  SYSTEM
}

enum ProviderName {
  OPENAI
  ANTHROPIC
  GOOGLE
  XAI
  MUSE
  SPARK
}

enum CouncilRunStatus {
  PENDING
  ROUND_1
  CRITIQUE
  CHAIRMAN
  DISCUSSING
  COMPLETED
  PARTIAL
  FAILED
}

enum ModelRunStage {
  SOLO
  COMPARE
  ROUND_1
  CRITIQUE
  CHAIRMAN
  DISCUSSION
}

/// A multi-model run is either a structured Council (independent → anonymous
/// critique → chairman) or an open Discussion (models speak in turn and can
/// see each other). Both share the same ledger and analytics.
enum CouncilRunKind {
  COUNCIL
  DISCUSSION
}

enum CouncilRole {
  STRATEGIST
  RISK_ANALYST
  RESEARCHER
  DEVILS_ADVOCATE
  CREATIVE
  EXECUTION
  CHAIRMAN
  GENERAL
}

enum ModelRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED
}

/// How a discussion is meant to be conducted. Collaborative is the default:
/// a group that is building one answer, not scoring points.
enum DiscussionStyle {
  COLLABORATIVE
  DEBATE
}

enum PricingStatus {
  CALCULATED
  /// Filled in after the fact, at a rate that was set later than the call.
  /// Never produced by the router — only by the pricing backfill.
  ESTIMATED
  MISSING
  UNSUPPORTED
}

// ─────────────────────────────────────────────
// Core tables
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

model Session {
  id     String        @id @default(uuid()) @db.Uuid
  userId String?       @db.Uuid
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  title  String
  mode   SessionMode
  status SessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    Message[]
  councilRuns CouncilRun[]
  modelRuns   ModelRun[]

  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])
}

model Message {
  id        String        @id @default(uuid()) @db.Uuid
  sessionId String        @db.Uuid
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  source    MessageSource
  content   String        @db.Text

  modelRunId String?   @db.Uuid
  modelRun   ModelRun? @relation(fields: [modelRunId], references: [id], onDelete: SetNull)

  // Set when a person speaks INSIDE a running discussion. The opening question
  // uses the CouncilUserMessage relation below instead; correlating an
  // interjection by session would be wrong, because one session can hold
  // several runs.
  councilRunId String?     @db.Uuid
  councilRun   CouncilRun? @relation("CouncilRunMessages", fields: [councilRunId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  councilRunsAsUserMessage CouncilRun[] @relation("CouncilUserMessage")

  @@index([sessionId, createdAt])
  @@index([councilRunId, createdAt])
}

model CouncilRun {
  id            String  @id @default(uuid()) @db.Uuid
  sessionId     String  @db.Uuid
  session       Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userMessageId String  @db.Uuid
  userMessage   Message @relation("CouncilUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)

  /** Interjections typed by a person while this run was in progress. */
  interjections Message[] @relation("CouncilRunMessages")

  kind         CouncilRunKind   @default(COUNCIL)
  status       CouncilRunStatus @default(PENDING)
  currentStage ModelRunStage?

  /// DISCUSSION only: how many speaking rounds were requested, and which
  /// round is in progress.
  totalRounds  Int?
  currentRound Int?

  /// DISCUSSION only. Stored rather than kept in the run config so history
  /// shows how a meeting was conducted, not just what was said.
  discussionStyle DiscussionStyle @default(COLLABORATIVE)

  /// A Discussion may run without a closing summary, so these are optional.
  chairmanProvider ProviderName?
  chairmanModel    String?

  startedAt   DateTime?
  completedAt DateTime?

  totalInputTokens       Int @default(0)
  totalOutputTokens      Int @default(0)
  totalCachedInputTokens Int @default(0)
  totalReasoningTokens   Int @default(0)
  totalTokens            Int @default(0)

  totalCostUsd Decimal? @db.Decimal(18, 10)

  totalLatencyMs Int?

  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modelRuns ModelRun[]

  @@index([sessionId, createdAt])
  @@index([status])
  @@index([kind])
}

// ─────────────────────────────────────────────
// ModelRun — the billing ledger.
// Every billable AI API call creates exactly one auditable ModelRun record.
// ─────────────────────────────────────────────

model ModelRun {
  id           String      @id @default(uuid()) @db.Uuid
  sessionId    String      @db.Uuid
  session      Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  councilRunId String?     @db.Uuid
  councilRun   CouncilRun? @relation(fields: [councilRunId], references: [id], onDelete: SetNull)

  provider ProviderName
  modelId  String

  stage  ModelRunStage
  role   CouncilRole    @default(GENERAL)
  status ModelRunStatus @default(PENDING)

  /// DISCUSSION only: speaking order, so the transcript replays exactly as it
  /// happened rather than being reconstructed from near-identical timestamps.
  roundNumber Int?
  turnIndex   Int?

  prompt   String  @db.Text
  response String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  latencyMs   Int?

  attemptCount Int @default(1)

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  cachedInputTokens Int?
  reasoningTokens   Int?

  providerRequestId String?
  finishReason      String?

  errorCode    String?
  errorMessage String? @db.Text

  rawUsage            Json?
  rawResponseMetadata Json?

  // ── Pricing snapshot (immutable record of the price in force at call time)
  inputPricePerMillionUsd       Decimal? @db.Decimal(18, 10)
  outputPricePerMillionUsd      Decimal? @db.Decimal(18, 10)
  cachedInputPricePerMillionUsd Decimal? @db.Decimal(18, 10)
  reasoningPricePerMillionUsd   Decimal? @db.Decimal(18, 10)

  // ── Calculated cost
  inputCostUsd      Decimal? @db.Decimal(18, 10)
  outputCostUsd     Decimal? @db.Decimal(18, 10)
  cachedInputCostUsd Decimal? @db.Decimal(18, 10)
  reasoningCostUsd  Decimal? @db.Decimal(18, 10)
  totalCostUsd      Decimal? @db.Decimal(18, 10)

  pricingStatus      PricingStatus @default(MISSING)
  pricingEffectiveAt DateTime?
  pricingSource      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([councilRunId])
  @@index([sessionId])
  @@index([provider, modelId])
  @@index([stage])
  @@index([status])
  @@index([startedAt])
}

// ─────────────────────────────────────────────
// Configuration tables
// ─────────────────────────────────────────────

model ModelConfig {
  id       String       @id @default(uuid()) @db.Uuid
  provider ProviderName
  modelId  String

  displayName String
  enabled     Boolean @default(true)

  supportsStreaming Boolean @default(true)
  supportsVision    Boolean @default(false)
  supportsReasoning Boolean @default(false)

  defaultRole CouncilRole @default(GENERAL)

  sortOrder Int @default(0)

  temperature     Float?
  maxOutputTokens Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, modelId])
}

/// Small mutable key/value settings that are display preferences, not ledger
/// facts. The billing ledger is US dollars and stays that way; anything in
/// here only changes how it is shown.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ModelPricing {
  id       String       @id @default(uuid()) @db.Uuid
  provider ProviderName
  modelId  String

  currency String @default("USD")

  inputPerMillion       Decimal  @db.Decimal(18, 10)
  outputPerMillion      Decimal  @db.Decimal(18, 10)
  cachedInputPerMillion Decimal? @db.Decimal(18, 10)
  reasoningPerMillion   Decimal? @db.Decimal(18, 10)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, modelId, effectiveFrom])
}
